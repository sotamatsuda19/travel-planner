# 必須：Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-...

# 任意：会話履歴を Supabase に永続化する（未設定ならプロセスメモリ＝再起動で消える）
# service_role キーは RLS をバイパスする全権キー。サーバ専用。絶対に NEXT_PUBLIC_ を付けないこと。
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 任意：経路探索に OSRM を使う（未設定なら公開デモサーバ。到達できなければ直線近似に自動フォールバック）
# OSRM_URL=http://localhost:5000
# OSRM_TIMEOUT_MS=2500

# 任意：外部 API を完全に切って動かす（オフラインデモ用）
# DISABLE_OSRM=1
# DISABLE_ELEVATION=1
